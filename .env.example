# Local development
DATABASE_URL=postgres://localhost:5432/yardstick_dev

# Only needed where the provider has a separate pooler that cannot run DDL (Neon, with
# channel_binding stripped). Railway Postgres has no such pooler, so leave this empty.
DATABASE_URL_UNPOOLED=

# web | worker. Picks which process the container starts. Irrelevant for `npm run dev`.
SERVICE_ROLE=web

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in stays dormant until both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Places import stays dormant until this is set. Every call is billed.
GOOGLE_PLACES_API_KEY=

# Rank data for the local grid. Both halves or the grid pillar reports itself unmeasured.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# AI visibility. Dormant without a key, since every probe is a paid completion.
ANTHROPIC_API_KEY=
# Which assistant we measure. Stamped on every stored probe; changing it starts a new
# trend line, so change it deliberately.
ANTHROPIC_MODEL=claude-sonnet-5
